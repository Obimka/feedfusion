# FeedFusion Configuration

# Server configuration
PORT=8081

# Database configuration
DB_PATH=rss.db

# Configuration file path
CONFIG_PATH=data/config.yaml

# Authentication configuration (REQUIRED in production)
# Generate a secure random key: openssl rand -base64 32
JWT_SECRET=your-very-secure-random-key-change-this-in-production

# First admin user (created on first run if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Text-to-Speech configuration (optional)
# Get your API key from https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key
