package auth

import (
	"net/http"
	"strings"

	"github.com/gorilla/mux"
)

// AuthMiddleware creates a middleware that validates JWT tokens
func AuthMiddleware(config JWTConfig) mux.MiddlewareFunc {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			// Skip authentication for certain paths
			if isPublicPath(r.URL.Path) {
				next.ServeHTTP(w, r)
				return
			}

			// Get token from Authorization header
			authHeader := r.Header.Get("Authorization")
			if authHeader == "" {
				// Also check cookies
				cookie, err := r.Cookie("token")
				if err != nil {
					http.Error(w, ErrUnauthorized.Error(), http.StatusUnauthorized)
					return
				}
				authHeader = cookie.Value
			}

			// Extract token from Bearer scheme
			tokenString := strings.TrimPrefix(authHeader, "Bearer ")
			if tokenString == authHeader {
				// No Bearer prefix, try as-is
				tokenString = authHeader
			}

			// Validate token
			claims, err := ValidateJWT(tokenString, config)
			if err != nil {
				http.Error(w, err.Error(), http.StatusUnauthorized)
				return
			}

			// Add user info to request context
			ctx := WithUser(r.Context(), claims)
			next.ServeHTTP(w, r.WithContext(ctx))
		})
	}
}

// isPublicPath checks if the path should be accessible without authentication
func isPublicPath(path string) bool {
	publicPaths := []string{
		"/api/login",
		"/api/refresh",
		"/api/logout",
		"/health",
		"/",
		"/static",
		"/login",
		"/websub/callback",
	}

	for _, p := range publicPaths {
		if path == p || strings.HasPrefix(path, p+"/") {
			return true
		}
	}
	return false
}

// OptionalAuthMiddleware creates a middleware that extracts user info if token exists
// but doesn't require authentication
func OptionalAuthMiddleware(config JWTConfig) mux.MiddlewareFunc {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			authHeader := r.Header.Get("Authorization")
			if authHeader == "" {
				cookie, err := r.Cookie("token")
				if err != nil {
					next.ServeHTTP(w, r)
					return
				}
				authHeader = cookie.Value
			}

			tokenString := strings.TrimPrefix(authHeader, "Bearer ")
			if tokenString == authHeader {
				tokenString = authHeader
			}

			claims, err := GetUserFromToken(tokenString, config)
			if err == nil {
				ctx := WithUser(r.Context(), claims)
				next.ServeHTTP(w, r.WithContext(ctx))
				return
			}

			next.ServeHTTP(w, r)
		})
	}
}

// AdminMiddleware creates a middleware that checks if user is admin
func AdminMiddleware(config JWTConfig) mux.MiddlewareFunc {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			authHeader := r.Header.Get("Authorization")
			if authHeader == "" {
				cookie, err := r.Cookie("token")
				if err != nil {
					http.Error(w, ErrUnauthorized.Error(), http.StatusUnauthorized)
					return
				}
				authHeader = cookie.Value
			}

			tokenString := strings.TrimPrefix(authHeader, "Bearer ")
			if tokenString == authHeader {
				tokenString = authHeader
			}

			claims, err := ValidateJWT(tokenString, config)
			if err != nil {
				http.Error(w, err.Error(), http.StatusUnauthorized)
				return
			}

			if !claims.IsAdmin {
				http.Error(w, ErrUnauthorized.Error(), http.StatusForbidden)
				return
			}

			ctx := WithUser(r.Context(), claims)
			next.ServeHTTP(w, r.WithContext(ctx))
		})
	}
}
